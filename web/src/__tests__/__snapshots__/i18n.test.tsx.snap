exports[`language switch > switches every visible label to Bangla and back (snapshots of two pages) 1`] = `"<form class="mx-auto mt-8 max-w-sm rounded-lg bg-white p-6 shadow"><h1 class="mb-4 text-xl font-bold text-slate-900">FastRobox</h1><label for="username" class="block text-sm text-slate-600">Username</label><input id="username" autocomplete="username" class="mt-1 w-full rounded border border-slate-300 px-3 py-1.5" value=""><label for="password" class="mt-3 block text-sm text-slate-600">Password</label><input id="password" type="password" autocomplete="current-password" class="mt-1 w-full rounded border border-slate-300 px-3 py-1.5" value=""><button type="submit" class="mt-4 w-full rounded bg-slate-900 px-3 py-2 text-sm font-semibold text-white disabled:cursor-not-allowed disabled:opacity-40">Log in</button></form>"`;

exports[`language switch > switches every visible label to Bangla and back (snapshots of two pages) 2`] = `"<div><div class="flex items-center gap-3"><h1 class="text-lg font-bold text-slate-900">R-305</h1><span class="text-xs text-slate-400">Reconnecting…</span><a class="ml-auto text-xs text-slate-500 underline" href="/rooms/R-305/health">Device health</a></div><div class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-4"><div data-testid="card-status" class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm"><span class="block text-xs font-medium uppercase tracking-wide text-slate-500">Status</span><span class="mt-1 block text-xl font-semibold text-slate-900">DANGER</span></div><div data-testid="card-temp_c" class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm"><span class="block text-xs font-medium uppercase tracking-wide text-slate-500">Temperature (°C)</span><span class="mt-1 block text-xl font-semibold text-slate-900">41.0</span></div><div data-testid="card-rh" class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm"><span class="block text-xs font-medium uppercase tracking-wide text-slate-500">Humidity (%)</span><span class="mt-1 block text-xl font-semibold text-slate-900">70.0</span></div><div data-testid="card-heat_index_c" class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm"><span class="block text-xs font-medium uppercase tracking-wide text-slate-500">Heat index (°C)</span><span class="mt-1 block text-xl font-semibold text-slate-900">36.1</span></div><div data-testid="card-heat_trend" class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm"><span class="block text-xs font-medium uppercase tracking-wide text-slate-500">Heat trend</span><span class="mt-1 block text-xl font-semibold text-slate-900">RISING</span></div><div data-testid="card-door" class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm"><span class="block text-xs font-medium uppercase tracking-wide text-slate-500">Door</span><span class="mt-1 block text-xl font-semibold text-slate-900">UNLOCKED</span></div><div data-testid="card-flame" class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm"><span class="block text-xs font-medium uppercase tracking-wide text-slate-500">Flame</span><span class="mt-1 block text-xl font-semibold text-slate-900">—</span></div><div data-testid="card-online" class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm"><span class="block text-xs font-medium uppercase tracking-wide text-slate-500">Online</span><span class="mt-1 block text-xl font-semibold text-slate-900">online</span></div></div><div class="mt-4 flex items-center gap-3"><button type="button" class="rounded bg-orange-600 px-3 py-1.5 text-sm font-semibold text-white disabled:cursor-not-allowed disabled:opacity-40">Reset fire</button></div><section data-testid="recent-events" class="mt-6 rounded-lg border border-slate-200 bg-white p-4 shadow-sm"><h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Recent events</h2><p class="mt-2 text-slate-500">No events yet</p></section></div>"`;

exports[`language switch > switches every visible label to Bangla and back (snapshots of two pages) 3`] = `"<form class="mx-auto mt-8 max-w-sm rounded-lg bg-white p-6 shadow"><h1 class="mb-4 text-xl font-bold text-slate-900">ফাস্টরোবক্স</h1><label for="username" class="block text-sm text-slate-600">ব্যবহারকারী</label><input id="username" autocomplete="username" class="mt-1 w-full rounded border border-slate-300 px-3 py-1.5" value=""><label for="password" class="mt-3 block text-sm text-slate-600">পাসওয়ার্ড</label><input id="password" type="password" autocomplete="current-password" class="mt-1 w-full rounded border border-slate-300 px-3 py-1.5" value=""><button type="submit" class="mt-4 w-full rounded bg-slate-900 px-3 py-2 text-sm font-semibold text-white disabled:cursor-not-allowed disabled:opacity-40">লগইন</button></form>"`;

exports[`language switch > switches every visible label to Bangla and back (snapshots of two pages) 4`] = `"<div><div class="flex items-center gap-3"><h1 class="text-lg font-bold text-slate-900">R-305</h1><span class="text-xs text-slate-400">পুনরায় সংযোগ চলছে…</span><a class="ml-auto text-xs text-slate-500 underline" href="/rooms/R-305/health">ডিভাইসের অবস্থা</a></div><div class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-4"><div data-testid="card-status" class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm"><span class="block text-xs font-medium uppercase tracking-wide text-slate-500">অবস্থা</span><span class="mt-1 block text-xl font-semibold text-slate-900">বিপদ</span></div><div data-testid="card-temp_c" class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm"><span class="block text-xs font-medium uppercase tracking-wide text-slate-500">তাপমাত্রা (°C)</span><span class="mt-1 block text-xl font-semibold text-slate-900">41.0</span></div><div data-testid="card-rh" class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm"><span class="block text-xs font-medium uppercase tracking-wide text-slate-500">আর্দ্রতা (%)</span><span class="mt-1 block text-xl font-semibold text-slate-900">70.0</span></div><div data-testid="card-heat_index_c" class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm"><span class="block text-xs font-medium uppercase tracking-wide text-slate-500">হিট ইনডেক্স (°C)</span><span class="mt-1 block text-xl font-semibold text-slate-900">36.1</span></div><div data-testid="card-heat_trend" class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm"><span class="block text-xs font-medium uppercase tracking-wide text-slate-500">তাপের ধারা</span><span class="mt-1 block text-xl font-semibold text-slate-900">RISING</span></div><div data-testid="card-door" class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm"><span class="block text-xs font-medium uppercase tracking-wide text-slate-500">দরজা</span><span class="mt-1 block text-xl font-semibold text-slate-900">UNLOCKED</span></div><div data-testid="card-flame" class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm"><span class="block text-xs font-medium uppercase tracking-wide text-slate-500">আগুন</span><span class="mt-1 block text-xl font-semibold text-slate-900">—</span></div><div data-testid="card-online" class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm"><span class="block text-xs font-medium uppercase tracking-wide text-slate-500">সংযোগ</span><span class="mt-1 block text-xl font-semibold text-slate-900">সংযুক্ত</span></div></div><div class="mt-4 flex items-center gap-3"><button type="button" class="rounded bg-orange-600 px-3 py-1.5 text-sm font-semibold text-white disabled:cursor-not-allowed disabled:opacity-40">আগুন রিসেট</button></div><section data-testid="recent-events" class="mt-6 rounded-lg border border-slate-200 bg-white p-4 shadow-sm"><h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">সাম্প্রতিক ঘটনা</h2><p class="mt-2 text-slate-500">এখনো কোনো ঘটনা নেই</p></section></div>"`;
